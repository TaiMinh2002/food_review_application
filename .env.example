# Copy this file to .env for local tooling or a future trusted backend.
# Never bundle .env as a Flutter asset.
APP_ENV=development

# Public client configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_USER_AGENT_PACKAGE_NAME=com.minhpt.foodreview

# Server/admin only; never expose these values to the Flutter application.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIREBASE_SERVICE_ACCOUNT_PATH=
