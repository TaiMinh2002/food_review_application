rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function placePath(placeKey) {
      return /databases/$(database)/documents/places/$(placeKey);
    }

    function validPlaceKey(placeKey) {
      return placeKey.matches('^osm_(node|way|relation)_[1-9][0-9]*$');
    }

    function activePlace(placeKey) {
      return validPlaceKey(placeKey) &&
        exists(placePath(placeKey)) &&
        get(placePath(placeKey)).data.status == 'active';
    }

    function validBookmark() {
      return request.resource.data.keys().hasOnly(['createdAt']) &&
        request.resource.data.keys().hasAll(['createdAt']) &&
        request.resource.data.createdAt == request.time;
    }

    function validCollectionData() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'description', 'placeIds', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'description', 'placeIds', 'coverUrl', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
        data.description is string && data.description.size() <= 300 &&
        data.placeIds is list && data.placeIds.size() <= 50 &&
        data.get('coverUrl', '') is string && data.get('coverUrl', '').size() <= 2048;
    }

    function validReportSubmission() {
      let data = request.resource.data;
      return data.keys().hasAll(['targetType', 'targetId', 'reason', 'description', 'evidenceCount', 'status', 'createdAt']) &&
        data.keys().hasOnly(['targetType', 'targetId', 'placeId', 'reason', 'description', 'evidenceCount', 'status', 'createdAt']) &&
        data.targetType in ['place', 'review', 'user'] &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 200 &&
        data.reason in ['inaccurate', 'harassment', 'spam', 'inappropriatePhoto', 'fakeReview', 'other'] &&
        data.description is string && data.description.size() <= 500 &&
        data.evidenceCount is int && data.evidenceCount >= 0 && data.evidenceCount <= 3 &&
        data.status == 'pending' &&
        data.createdAt == request.time;
    }

    function validPublicProfile(uid) {
      return request.resource.data.keys().hasOnly([
        'displayName', 'photoUrl', 'bio', 'region', 'status',
        'createdAt', 'updatedAt'
      ]) &&
        request.resource.data.keys().hasAll([
          'displayName', 'status', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 1 &&
        request.resource.data.displayName.size() <= 60 &&
        request.resource.data.status == 'active' &&
        request.resource.data.get('photoUrl', '') is string &&
        request.resource.data.get('photoUrl', '').size() <= 2048 &&
        request.resource.data.get('bio', '') is string &&
        request.resource.data.get('bio', '').size() <= 300 &&
        request.resource.data.get('region', '') is string &&
        request.resource.data.get('region', '').size() <= 80 &&
        request.resource.data.updatedAt == request.time;
    }

    function validReviewData(placeKey, uid) {
      let data = request.resource.data;
      return data.keys().hasAll(['placeId', 'userId', 'rating', 'content', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'placeId', 'userId', 'authorName', 'rating', 'title', 'content',
          'visitDate', 'companion', 'dishes', 'imageUrls', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.placeId == placeKey &&
        data.userId == uid &&
        data.status in ['public', 'hidden'] &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.content is string && data.content.size() >= 10 && data.content.size() <= 3000 &&
        data.get('authorName', '') is string && data.get('authorName', '').size() <= 60 &&
        data.get('title', '') is string && data.get('title', '').size() <= 100 &&
        data.get('companion', '') is string && data.get('companion', '').size() <= 50 &&
        data.get('imageUrls', []) is list && data.get('imageUrls', []).size() <= 10 &&
        data.get('dishes', []) is list && data.get('dishes', []).size() <= 20;
    }

    match /places/{placeKey} {
      allow get: if validPlaceKey(placeKey) && resource.data.status == 'active';
      allow list, create, update, delete: if false;

      match /reviews/{reviewId} {
        allow read: if resource.data.status == 'public' || signedInAs(reviewId);
        allow create: if signedInAs(reviewId) &&
          validReviewData(placeKey, reviewId) &&
          request.resource.data.status == 'public' &&
          request.resource.data.createdAt == request.time;
        allow update: if signedInAs(reviewId) &&
          validReviewData(placeKey, reviewId) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.placeId == resource.data.placeId &&
          request.resource.data.updatedAt == request.time;
        allow delete: if signedInAs(reviewId);
      }
    }

    match /users/{uid} {
      allow get: if resource.data.status == 'active';
      allow list, delete: if false;
      allow create: if signedInAs(uid) && validPublicProfile(uid) &&
        request.resource.data.createdAt == request.time;
      allow update: if signedInAs(uid) && validPublicProfile(uid) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoUrl', 'bio', 'region', 'updatedAt'
        ]);

      match /favorites/{placeKey} {
        allow read, delete: if signedInAs(uid);
        allow create: if signedInAs(uid) && activePlace(placeKey) &&
          validBookmark();
        allow update: if false;
      }

      match /wantToVisit/{placeKey} {
        allow read, delete: if signedInAs(uid);
        allow create: if signedInAs(uid) && activePlace(placeKey) &&
          validBookmark();
        allow update: if false;
      }

      match /collections/{collectionId} {
        allow read, delete: if signedInAs(uid);
        allow create: if signedInAs(uid) && validCollectionData() &&
          request.resource.data.createdAt == request.time;
        allow update: if signedInAs(uid) && validCollectionData() &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time;
      }

      // All other user private subcollections are closed
      match /{privateDocument=**} {
        allow read, write: if false;
      }
    }

    match /reports/{uid}/submissions/{requestId} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid) && validReportSubmission();
      allow update, delete: if false;

      match /evidence/{evidenceId} {
        allow read: if signedInAs(uid);
        allow create: if signedInAs(uid) &&
          request.resource.data.keys().hasAll(['name', 'createdAt']) &&
          request.resource.data.keys().hasOnly(['name', 'bytes', 'createdAt']) &&
          request.resource.data.name is string && request.resource.data.name.size() <= 255 &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
